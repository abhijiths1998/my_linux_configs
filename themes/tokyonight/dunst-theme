# Tokyo Night - Dunst Notification Colors

[global]
transparency = 15
frame_width = 2
corner_radius = 12

[urgency_low]
background = "#24283b"
foreground = "#a9b1d6"
frame_color = "#7aa2f7"
timeout = 5

[urgency_normal]
background = "#1a1b26"
foreground = "#c0caf5"
frame_color = "#7aa2f7"
timeout = 10

[urgency_critical]
background = "#1a1b26"
foreground = "#c0caf5"
frame_color = "#f7768e"
timeout = 0
