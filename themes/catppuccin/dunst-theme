# Catppuccin Mocha - Dunst Notification Colors

[global]
transparency = 18
frame_width = 2
corner_radius = 12

[urgency_low]
background = "#313244"
foreground = "#a6adc8"
frame_color = "#cba6f7"
timeout = 5

[urgency_normal]
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#cba6f7"
timeout = 10

[urgency_critical]
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#f38ba8"
timeout = 0
